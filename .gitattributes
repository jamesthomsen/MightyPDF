# What a `composer require` pulls down. Everything here is how the
# library is developed rather than part of it, and a consumer vendoring
# MightyPDF has no use for any of it -- the test fixtures alone are
# larger than the source they test.

/tests          export-ignore
/examples       export-ignore
/tools          export-ignore
/.github        export-ignore

# docs/ is deliberately *not* here. It is the manual that used to be the
# body of README.md, which a `composer require` has always pulled down,
# and the README that ships links into it.
/phpunit.xml    export-ignore
/phpstan.neon   export-ignore
/phpstan-baseline.neon export-ignore
/.gitignore     export-ignore
/.gitattributes export-ignore
/.claude        export-ignore
