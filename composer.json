{
    "name": "jamesthomsen/mightypdf",
    "description": "A from-scratch PDF library for PHP: raw PDF assembly plus a content layer for text, drawing, images, SVG, and AcroForm fields -- and a reader that can open an existing PDF and edit it in place.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "James Thomsen",
            "email": "james.thomsen@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MightyPDF\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MightyPDF\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
